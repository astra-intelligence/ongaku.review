{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "allowJs": true, "checkJs": true, "resolveJsonModule": true,
    "verbatimModuleSyntax": true, "isolatedModules": true, "skipLibCheck": true,
    "noEmit": true, "types": ["node", "svelte", "vite/client"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.svelte",
    "e2e/**/*.ts",
    "vite.config.ts",
    "playwright.config.ts",
    "svelte.config.js"
  ]
}
